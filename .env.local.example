# Copie ce fichier en .env.local et choisis un mot de passe.
# Sur Vercel : Project → Settings → Environment Variables (mêmes clés).
# La console /admin est protégée par ces identifiants (HTTP Basic Auth).

ADMIN_USER=admin
ADMIN_PASSWORD=change-moi

# Publication directe sur GitHub depuis la console /admin.
# Personal Access Token (fine-grained) avec la permission "Contents: Read and write"
# sur le repo WineSociety-Lausanne/Wine-Society-Web.
# À créer sur https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=

# Optionnel — valeurs par défaut déjà correctes pour ce repo :
# GITHUB_OWNER=WineSociety-Lausanne
# GITHUB_REPO=Wine-Society-Web
# GITHUB_BRANCH=main
# GITHUB_PATH=src/data/events.json
